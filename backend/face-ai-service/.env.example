PORT=3006
HOST=0.0.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/face_ai_db

FACE_SIMILARITY_THRESHOLD=0.70
LIVENESS_CONFIDENCE_THRESHOLD=0.80
CHALLENGE_TIMEOUT_SECONDS=30
VERIFICATION_TOKEN_TTL_SECONDS=300

GATEWAY_SHARED_SECRET=dev-gateway-secret
FACE_JWT_SECRET=dev-face-secret-key-change-in-prod
