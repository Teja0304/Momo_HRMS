# Copy this file to .env and fill in real values. The service refuses to
# start if a secret is missing, too short, or left as a placeholder.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# MySQL 8 connection string: mysql://user:password@host:port/database
DATABASE_URL="mysql://root:your-mysql-password@localhost:3306/momo_hrms"
DB_POOL_SIZE=10
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# MUST be the exact same value as JWT_ACCESS_SECRET in backend/auth-service/.env
# Generate one with: node scripts/generate-secrets.js
JWT_ACCESS_SECRET=change-me-to-a-random-64-character-string-shared-with-auth-service

# Shared secret the attendance service sends as X-Internal-Api-Key.
# Generate one with: node scripts/generate-secrets.js
INTERNAL_SERVICE_API_KEY=change-me-to-a-random-64-character-string

# Optional: base URL of the existing auth-service (e.g. http://localhost:3001/api/v1).
# Leave empty to disable auth-service role sync (employee-service still works
# on its own, roles just will not be pushed back to login accounts).
AUTH_SERVICE_URL=http://localhost:3001/api/v1
AUTH_SERVICE_TIMEOUT_MS=5000
