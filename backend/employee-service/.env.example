PORT=3004
NODE_ENV=development
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL=mysql://employee_user:employee_password@localhost:3306/employee_db

# Security & Gateway Secret
GATEWAY_SHARED_SECRET=dev-gateway-secret
GATEWAY_SHARED_SECRET_HEADER=x-gateway-secret
GATEWAY_ROLES_HEADER=x-roles
EMPLOYEE_DEV_AUTH=true
