// Employee Service - Prisma Schema
// Owns ONLY employee profile records, departments, designations, and office assignments.
// Does NOT own user passwords/roles (Auth Service) or attendance data (Attendance Service).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
}

model Department {
  id           String        @id @default(uuid())
  code         String        @unique @db.VarChar(64)
  name         String        @db.VarChar(128)
  description  String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  designations Designation[]
  employees    Employee[]

  @@map("departments")
}

model Designation {
  id           String      @id @default(uuid())
  code         String      @unique @db.VarChar(64)
  title        String      @db.VarChar(128)
  departmentId String?     @map("department_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([departmentId])
  @@map("designations")
}

model Employee {
  id               String                   @id @default(uuid())
  employeeCode     String                   @unique @map("employee_code") @db.VarChar(64)
  userId           String?                  @unique @map("user_id") @db.VarChar(64)
  firstName        String                   @map("first_name") @db.VarChar(64)
  lastName         String                   @map("last_name") @db.VarChar(64)
  email            String                   @unique @db.VarChar(255)
  phone            String?                  @db.VarChar(32)
  departmentId     String?                  @map("department_id")
  designationId    String?                  @map("designation_id")
  employmentStatus EmploymentStatus         @default(ACTIVE) @map("employment_status")
  dateOfJoining    DateTime                 @default(now()) @map("date_of_joining")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?             @relation(fields: [designationId], references: [id], onDelete: SetNull)
  assignments      EmployeeOfficeAssignment[]

  @@index([departmentId])
  @@index([designationId])
  @@index([employmentStatus])
  @@map("employees")
}

model EmployeeOfficeAssignment {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  officeId      String    @map("office_id") @db.VarChar(64)
  isPrimary     Boolean   @default(true) @map("is_primary")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([officeId])
  @@index([isActive])
  @@map("employee_office_assignments")
}
