# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
SWAGGER_PATH=api/docs

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://attendance_user:attendance_password@localhost:3306/attendance_service"

# ---------------------------------------------------------------------------
# Development authentication (NEVER enable this in production)
#
# When true, every request may pass X-Employee-Id / X-User-Id / X-Roles
# headers directly and the service trusts them as-is, with no signature
# verification. This exists ONLY so the Attendance Service can be
# developed and tested standalone before the API Gateway / Auth Service
# integration is wired up. See src/common/guards for the production
# GatewayAuthGuard this is swapped for.
# ---------------------------------------------------------------------------
ATTENDANCE_DEV_AUTH=true
DEV_DEFAULT_EMPLOYEE_ID=EMP-001

# ---------------------------------------------------------------------------
# Production auth (used when ATTENDANCE_DEV_AUTH=false)
# The API Gateway is expected to forward the authenticated identity as
# these headers after validating the caller's access token itself.
# Adjust header names here to match your actual gateway configuration.
# ---------------------------------------------------------------------------
GATEWAY_EMPLOYEE_ID_HEADER=x-employee-id
GATEWAY_USER_ID_HEADER=x-user-id
GATEWAY_ROLES_HEADER=x-roles
# Shared secret the gateway must send so this service can confirm the
# identity headers were actually set by the gateway and not the caller.
GATEWAY_SHARED_SECRET=change-me-gateway-secret
GATEWAY_SHARED_SECRET_HEADER=x-gateway-secret

# ---------------------------------------------------------------------------
# Attendance policy (V1 static/config-driven; see AttendancePolicyProvider)
# ---------------------------------------------------------------------------
POLICY_CHECK_IN_START_TIME=07:00
POLICY_CHECK_IN_END_TIME=10:00
POLICY_LATE_THRESHOLD_MINUTES=15
POLICY_GRACE_PERIOD_MINUTES=60
POLICY_AUTO_CHECKOUT_ENABLED=true
POLICY_WORKING_HOURS_PER_DAY=8
POLICY_ALLOW_MANUAL_CHECKOUT_WHILE_PAUSED=false
POLICY_MIN_LOCATION_ACCURACY_METERS=50

# ---------------------------------------------------------------------------
# Auto-checkout scheduler
# ---------------------------------------------------------------------------
AUTO_CHECKOUT_CRON=*/1 * * * *
AUTO_CHECKOUT_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---------------------------------------------------------------------------
# Redis (optional — not required for V1, reserved for future distributed
# locking/rate limiting/caching)
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Geofence Service Integration
# ---------------------------------------------------------------------------
GEOFENCE_SERVICE_URL=http://localhost:3003/api/v1
GEOFENCE_USE_MOCK=false

# ---------------------------------------------------------------------------
# Employee Service Integration
# ---------------------------------------------------------------------------
EMPLOYEE_SERVICE_URL=http://localhost:3004/api/v1
EMPLOYEE_USE_MOCK=false


