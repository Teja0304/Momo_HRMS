# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://auth_user:auth_password@localhost:3306/auth_service"

# ---------------------------------------------------------------------------
# JWT
# Generate real values with: npm run generate:secrets
# The service REFUSES TO START if these are left as placeholders, too
# short, or identical to each other — see src/config/validate-env.ts.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# ---------------------------------------------------------------------------
# Redis (optional - prepared for future distributed rate limiting / caching)
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Bootstrap SUPER_ADMIN (optional, used only by `prisma:seed`)
# ---------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@company.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123!
