PORT=3003
NODE_ENV=development
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection
DATABASE_URL=mysql://geofence_user:geofence_password@localhost:3306/geofence_db

# Security & API Gateway Shared Secret
GATEWAY_SHARED_SECRET=dev-gateway-secret
GATEWAY_SHARED_SECRET_HEADER=x-gateway-secret
GATEWAY_ROLES_HEADER=x-roles
GEOFENCE_DEV_AUTH=true
